PORT=3000
# For running the app on your machine. Docker Compose sets hosts and ports itself.
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=nestdb

REDIS_HOST=localhost
REDIS_PORT=6380

# Use two different random values, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-random-value
JWT_REFRESH_SECRET=replace-with-another-random-value
